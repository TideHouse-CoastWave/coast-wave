# Placeholder application settings only; not a deployable configuration.
# Replace in an approved local/staging environment after configuration review.
APP_ORIGIN=<application-origin>
ALLOWED_ORIGINS=<approved-comma-separated-origins>
PAYMENT_MODE=<disabled-or-approved-test-mode>
ORDER_RESERVATION_TTL_SECONDS=<approved-positive-integer>
CUSTOMER_ORDER_ACCESS_TTL_SECONDS=<approved-positive-integer>
ORDER_MAX_QUANTITY=1

# Server runtime secrets only; never VITE_ variables. Empty means unavailable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NCBA_NETWORK_ENABLED=false
NCBA_SANDBOX_APPROVED=false
NCBA_INITIATION_CONTRACT_CONFIRMED=false
# No default: the published c2bapis host is not labelled sandbox by NCBA.
NCBA_SANDBOX_BASE_URL=
NCBA_API_USERNAME=
NCBA_API_PASSWORD=
NCBA_PAYBILL=
NCBA_ACCOUNT_NO=
NCBA_MERCHANT_SCOPE=
# Bank-confirmed initiation ACCEPTANCE code, never payment success.
NCBA_CONFIRMED_ACCEPTED_CODE=
NCBA_NOTIFICATION_HASH_CONFIRMED=false
NCBA_NOTIFICATION_USERNAME=
NCBA_NOTIFICATION_PASSWORD=
NCBA_NOTIFICATION_SECRET=
# Independent high-entropy worker bearer credential, at least 32 characters.
PAYMENT_WORKER_SECRET=
